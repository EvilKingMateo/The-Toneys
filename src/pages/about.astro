---
import Layout from '../layouts/page.astro';
import Contact from '../layouts/sections/contact.astro'
import Reviews from '../layouts/sections/reviews.astro'
import Image from '../layouts/sections/image.astro'
import Text from '../layouts/sections/text.astro'
---

<Layout title='Meet The Band'>

<Text>
	Hello! We are The Toneys, a friendly jazz big band! 
	We call each other Tony, leading to some admittedly very confusing conversations in rehearsals…<br><br>

	We perform with a variety of line-ups, ranging from small ensemble, to big band with strings!
	<section id="about">
		<div class="grid-cell" id="cell1">
			<h3>Vocals</h3>
			<p>
				Vocals<br>
				Backing Vocals I<br>
				Backing Vocals II
			</p>
		</div>
		<div class="grid-cell" id="cell2">
			<h3>Horns</h3>
			<p>
				Flute<br>
				Alto Saxophone I<br>
				Alto Saxophone II<br>
				Tenor Saxophone<br>
				B♭/Bass Clarinet<br>
			</p>
			<p>
				Trumpet I<br>
				Trumpet II<br>
				Trumpet III<br>
			</p>	
		</div>
			<div class="grid-cell" id="cell3">
			<h3>Rhythm</h3>
			<p>
				Piano<br>
				Guitar<br>
				Double Bass and Vocals<br>
				Drums<br>
				Auxillary Percussion<br>
			</p>
		</div>
		<div class="grid-cell" id="cell4">
		<h3>Strings</h3>
			<p>
				Viola<br>
				Cello<br>
			</p>	
		</div>
	</section>
</Text>

</Layout>