---
import Layout from '../layouts/page.astro';
import Contact from '../layouts/sections/contact.astro'
import Reviews from '../layouts/sections/reviews.astro'
import Image from '../layouts/sections/image.astro'
import Text from '../layouts/sections/text.astro'
---

<style>

	#nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-template-rows: 1fr 1fr;
		gap: 20px;
	}

	#one {
		grid-column: 1;
		grid-row: 1;
	}

	#two {
		grid-column: 2;
		grid-row: 1;
	}

	#three {
		grid-column: 1;
		grid-row: 2;
	}

	@media (max-width: 1000px) {
		#nav {
			grid-template-columns: 1fr;
			grid-template-rows: 1fr 1fr 1fr;
			gap: 20px;
		}
		#one {
			grid-column: 1;
			grid-row: 1;
		}

		#two {
			grid-column: 1;
			grid-row: 2;
		}

		#three {
			grid-column: 1;
			grid-row: 3;
		}
	}
</style>

<Layout title="">
	<Image Src="https://assets.toneys.band/Band Picture.jpg" Alt="From a front stage wing: The Toneys playing live."><Image Src="./toneys/Logo+text.png" Alt="The Toneys logo and wordmark." Ratio="none" Class="seasonal"></Image></Image>

	<!--Reviews>
		
	</Reviews-->

	<br>

	<section id="nav">
		<Image Id="one" Src="./Battle of the Bands.jpeg" Alt="The Toneys playing live at their local Battle of the Bands 26" Href="/about">
			<h1>Meet The Band!</h1>
		</Image>

		<Image Id="two" Src="./ah.jpeg" Alt="Standing by a field: nine of The Toneys in a line" Href="/o7">
			<h1 style="font-family: var(--phoneysFont);">Sister Bands</h1>
		</Image>

		<Image Id="three" Src="Quiz Night.jpeg" Alt="The Toneys playing live at a quiz night" Href="/contact">
			<h1>Contact Us</h1>
		</Image>
	</section>

	<br>
</Layout>
