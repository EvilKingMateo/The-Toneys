---
interface Props {
	src: string;
    alt: string;
    text: string;
}

const {src, alt, text} = Astro.props;

---

<style>
    #container {
        position: relative;
        text-align: center;
    }

    img {
        width: 100%;
        display: block;
    }

    #text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 50px;
        text-shadow: 3px 3px 6px black;
    }
</style>


<div id="container">
    <img src={src} alt={alt} />
    <div id="text">
        <h1>{text}</h1>
    </div>
</div>