---
interface Props {
	src: string;
    alt: string;
}

const {src, alt} = Astro.props;

---

<style>
    #container {
        /*position relative causes the image to be displayed on top of everything else - not sure why so I just
        edited the image and logo into one so theres no need for image stacking here*/
        /* position: relative; */
        text-align: center;
    }

    img {
        width: 100%;
        display: block;
    }

    @keyframes my-animation {
        from {width: 90%}
        to {width: 100%}
    }

    #slot {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-shadow: 3px 3px 6px var(--background);
        display: flex;
        flex-direction: row;
        width: 85%;
        margin: auto;

        > * {
            margin: auto;
            filter: drop-shadow(5px 5px 5px var(--background));

            animation-name: my-animation;
            animation-duration: 2s;
        }
    }
</style>


<div id="container">
    <img src={src} alt={alt} />
    <div id="slot">
        <slot />
    </div>
</div>