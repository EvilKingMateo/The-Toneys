---
interface Props {
    Src: string;
    Alt: string;
    Id?: string;
    Class?: string;
    Onclick?: string;
    Href?: string;
    Ratio?: string;
}

const {
    Src, 
    Alt, 
    Id, 
    Class, 
    Onclick, 
    Href, 
    Ratio = "3/2"
} = Astro.props;

---

<style define:vars={{Ratio}}>
    section {
        /*position relative causes the image to be displayed on top of everything else - not sure why so I just
        edited the image and logo into one so theres no need for image stacking here*/

        /*i did it so that elements can be added over the top, allowing for quick changes (such as changing the logo for christmas), without having to use an image editor*/
        
        position: relative; 
        text-align: center;
        width: 100%;
        aspect-ratio: var(--Ratio);
    }

    img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
    }

    #slot {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-shadow: 3px 3px 6px var(--background);
        display: flex;
        flex-direction: row;
        width: 85%;
        margin: auto;
        pointer-events: none;
        

        > * {
            margin: auto;
            filter: drop-shadow(5px 5px 5px var(--background));
        }
    }
</style>


<section>
    <img id={Id} class={Class} src={Src} alt={Alt} onclick={Onclick + ';' + (Href ? `location.href = '${Href}'` : "")}>

    <div id="slot">
        <slot />
    </div>
</section>