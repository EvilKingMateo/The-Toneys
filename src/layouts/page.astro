---
import Boiler from './defaults/boilerplate.astro';
interface Props {
	title: string;
}

const {title} = Astro.props;

import '../styles/style.css';
---

<Boiler>
	<header id="header">
		<div id="left">
			<a href='/'>home</a>
			<a>meet the band</a>
		</div>

		<div id="centre"><a href='/'><b>The <span id="band">Toneys</span></b></a></div>

		<div id="right">
			<a href="/contact">contact</a>
			<a href="/o7">Sister Bands <i class="fa fa-caret-down"></i></a>
		</div>
	</header>
        
	<main>
		<h1>{title}</h1>
		<slot/>
	</main>

	<footer>
		<div><b>Menu:</b><a href="/">Home</a></div>
		<div>
			<b>Email:</b><a href="mailto: tony@toneys.band">tony@toneys.band</a><br>
			<b>Social Media:</b><a href="https://www.instagram.com/toneys.jazz/">Instagram</a></div>
		<div><b></b></div>
	</footer>

</Boiler>